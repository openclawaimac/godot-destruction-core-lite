extends Node2D
## Godot Destruction Core: Lite demo ("Collapse").
## Two local players drop charges on a destructible valley: a hollow brick
## keep, a timber bridge over a chasm and a steel watchtower. Cut the
## supports and the parts above come down as pieces, land as rubble and
## crush what they hit; everything is credited to the player who caused it.
##
## Lite only (no Pro classes): DKWorld + DKTileRenderer + DKChunkCollision +
## DKDebris + DKFeel. All art is generated by art_src/gen_art.gd.
##
## Controls: LMB = P1 charge, RMB = P2 charge, M = reduced motion,
## R = rebuild, SPACE = autoplay on/off. Autoplay runs until the first click.

const CELL := 8
const GRID := Vector2i(120, 62)
const WORLD_Y := 24
const MATERIAL_ROWS := {&"dirt": 0, &"rock": 1, &"brick": 2, &"wood": 3, &"steel": 4, &"bedrock": 5, &"rubble": 6}
const TILE_VARIANTS := 16
## Rock and bedrock use position-sliced seamless textures (see gen_art.gd).
const MACRO_TILES := {&"rock": Vector2i(4, 4), &"bedrock": Vector2i(8, 2)}
const PLAYER_COLORS := {1: Color("ffb347"), 2: Color("5ad1ff")}
const CHARGE_RADIUS := 26.0
const CHARGE_POWER := 40

## Scripted demolition: [tick, cell x, cell y, instigator].
const AUTOPLAY := [
	[50, 13, 43, 1], [80, 24, 43, 1],              # keep: both walls at the base
	[150, 55, 35, 2], [185, 68, 35, 2],            # bridge: both ends over the chasm
	[250, 91, 44, 1], [275, 91, 41, 1],            # watchtower: left leg
	[310, 101, 44, 2], [335, 101, 41, 2],          # watchtower: right leg
	[400, 40, 44, 1], [430, 84, 46, 2], [460, 30, 47, 1], [490, 110, 45, 2],
]
const AUTOPLAY_LOOP := 760

@export var autoplay := true
## When true nothing runs by itself; call simulate() (headless tests).
@export var manual := false

var world: DKWorld
var renderer: DKTileRenderer
var collision: DKChunkCollision
var debris: DKDebris
var feel: DKFeel
var camera: Camera2D
var fx: Node2D

var demo_tick := 0
var pieces_detached := 0
var pieces_landed := 0
var crush_log: Array = []  # [piece instigator, crush instigator, power]
var reduced_motion := false

var _explosions: Array = []  # {pos, t, color, r}
var _smoke: Array = []       # {pos, vel, t, life, r}
var _hud: Dictionary = {}
var font: DemoPixelFont
var ui_art: DemoUIArt
var hud: DemoHud
var callouts: DemoCallouts
var _callout_cd := 0
var _mouse := Vector2(-100, -100)


func _ready() -> void:
	camera = Camera2D.new()
	camera.position = Vector2(480, 270)
	add_child(camera)
	camera.make_current()

	var bg_layer := CanvasLayer.new()
	bg_layer.layer = -1
	add_child(bg_layer)
	var bg := Sprite2D.new()
	bg.texture = load("res://demos/lite_collapse/art/background.png")
	bg.centered = false
	bg.scale = Vector2(2, 2)
	bg_layer.add_child(bg)

	world = DKWorld.new()
	world.name = "World"
	world.auto_tick = false
	world.position = Vector2(0, WORLD_Y)
	world.rebuild_budget = 8
	world.setup(GRID.x, GRID.y, CELL, 16, _materials())
	add_child(world)

	renderer = DKTileRenderer.new()
	renderer.atlas = load("res://demos/lite_collapse/art/tiles.png")
	renderer.tile_px = 8
	renderer.variants = TILE_VARIANTS
	renderer.material_rows = MATERIAL_ROWS
	renderer.macro_tiles = MACRO_TILES
	world.add_child(renderer)
	renderer.bind_world(world)
	DemoGround.attach(world, renderer, 540.0)

	collision = DKChunkCollision.new()
	world.add_child(collision)
	collision.bind_world(world)

	debris = DKDebris.new()
	debris.auto_step = false
	world.add_child(debris)
	debris.bind_world(world)

	feel = DKFeel.new()
	feel.camera = camera
	feel.auto_process = not manual
	feel.use_time_scale = not manual
	add_child(feel)
	feel.bind_world(world)

	fx = Node2D.new()
	fx.position = world.position
	add_child(fx)
	fx.draw.connect(_draw_fx)

	world.piece_detached.connect(func(_p: Dictionary) -> void: pieces_detached += 1)
	world.piece_landed.connect(_on_landed)
	world.detonated.connect(_on_detonated)
	callouts = DemoCallouts.new()
	callouts.position = world.position
	add_child(callouts)
	_build_hud()
	callouts.setup(font, ui_art)
	build_level()
	if not manual:
		Input.mouse_mode = Input.MOUSE_MODE_HIDDEN


func _materials() -> DKMaterialSet:
	return DKMaterialSet.make([
		DKMaterial.make(&"dirt", 10, {"density": 2, "debris_color": Color("86583b"), "debris_count": 2}),
		DKMaterial.make(&"rock", 34, {"density": 3, "resist": {&"blast": 35}, "debris_color": Color("7d89a2"), "debris_count": 2, "rubble_into": &"rubble", "rubble_pct": 50}),
		DKMaterial.make(&"brick", 22, {"density": 3, "debris_color": Color("bb5a3c"), "debris_count": 3, "rubble_into": &"rubble", "rubble_pct": 40}),
		DKMaterial.make(&"wood", 12, {"density": 1, "debris_color": Color("a06e3e"), "debris_count": 2}),
		DKMaterial.make(&"steel", 30, {"density": 5, "resist": {&"blast": 40}, "debris_color": Color("8394b2"), "debris_count": 1}),
		DKMaterial.make(&"bedrock", 1, {"anchor": true, "falls": false, "debris_color": Color("30263f")}),
		DKMaterial.make(&"rubble", 6, {"density": 2, "debris_color": Color("8f7462"), "debris_count": 1}),
	])


# — Level —

## Builds the level rows (deterministic, no RNG).
static func level_rows() -> PackedStringArray:
	var g: Array = []  # flat, row-major character codes
	g.resize(GRID.x * GRID.y)
	g.fill(46)  # '.'
	var put := func(x: int, y: int, ch: String) -> void:
		if x >= 0 and y >= 0 and x < GRID.x and y < GRID.y:
			g[y * GRID.x + x] = ch.unicode_at(0)
	var rect := func(x0: int, y0: int, x1: int, y1: int, ch: String) -> void:
		for y in range(y0, y1 + 1):
			for x in range(x0, x1 + 1):
				put.call(x, y, ch)
	# Terrain: rolling hills, a chasm in the middle with rock cliffs.
	for x in GRID.x:
		var surf := 44 + int(round(2.5 * sin(x * 0.09) + 1.5 * sin(x * 0.23 + 1.0)))
		if x >= 53 and x <= 70:
			surf = 57 + int(round(1.2 * sin(x * 0.7)))
		for y in range(surf, GRID.y - 2):
			var deep := y - surf
			var ch := "#"
			var blob := DKDebris._hash(x / 3, y / 2, 5) % 100
			if (deep > 4 and blob < 18) or (deep > 9 and blob < 45):
				ch = "R"
			put.call(x, y, ch)
	# Rock cliffs/pillars holding the bridge.
	rect.call(46, 37, 52, 50, "R")
	rect.call(71, 37, 77, 50, "R")
	# Timber bridge across the chasm (rests on the pillar tops).
	rect.call(50, 35, 73, 36, "W")
	for x in range(55, 70, 4):  # railing posts (inside the gap, so the span can drop)
		rect.call(x, 32, x, 34, "W")
	rect.call(55, 31, 67, 31, "W")
	# Hollow brick keep with timber floors, windows and battlements.
	rect.call(11, 17, 26, 48, "B")
	rect.call(13, 20, 24, 43, ".")
	rect.call(13, 29, 24, 29, "W")
	rect.call(13, 36, 24, 36, "W")
	for wy in [23, 31, 38]:
		rect.call(11, wy, 11, wy + 2, ".")
		rect.call(26, wy, 26, wy + 2, ".")
	for x in range(11, 27, 3):
		rect.call(x, 15, x + 1, 16, "B")
	# Low wall beside the keep (separate, so the keep can fall on it).
	rect.call(29, 37, 36, 48, "B")
	rect.call(32, 39, 33, 41, ".")
	# Steel watchtower: two legs, cross braces, a deck and a brick hut.
	rect.call(91, 24, 91, 48, "S")
	rect.call(101, 24, 101, 48, "S")
	for k in 9:  # stair-stepped braces (4-connected)
		rect.call(92 + k, 26 + k, 93 + k, 26 + k, "S")
		rect.call(99 - k, 26 + k, 100 - k, 26 + k, "S")
	rect.call(88, 23, 104, 23, "S")
	rect.call(92, 16, 100, 22, "B")
	rect.call(94, 18, 95, 20, ".")
	rect.call(98, 18, 99, 20, ".")
	rect.call(90, 15, 102, 15, "W")
	rect.call(92, 14, 100, 14, "W")
	# Boulders on the hills.
	rect.call(4, 41, 6, 46, "R")
	rect.call(112, 41, 115, 46, "R")
	# Bedrock floor.
	rect.call(0, GRID.y - 2, GRID.x - 1, GRID.y - 1, "X")
	var rows := PackedStringArray()
	for y in GRID.y:
		var row := PackedByteArray()
		for x in GRID.x:
			row.append(int(g[y * GRID.x + x]))
		rows.append(row.get_string_from_ascii())
	return rows


const LEGEND := {"#": &"dirt", "R": &"rock", "B": &"brick", "W": &"wood", "S": &"steel", "X": &"bedrock", "r": &"rubble"}


func build_level() -> void:
	world.load_rows(level_rows(), LEGEND)
	world.tick_count = 0
	world.instigator_stats.clear()
	world.flush()
	world.check_all_support()
	debris.clear()
	_explosions.clear()
	_smoke.clear()
	demo_tick = 0
	pieces_detached = 0
	pieces_landed = 0
	crush_log.clear()
	fx.queue_redraw()


# — Simulation —

func _physics_process(_delta: float) -> void:
	if not manual:
		step_tick()


## Runs `ticks` fixed steps (headless tests, screenshots).
func simulate(ticks: int) -> void:
	for i in ticks:
		step_tick()


func step_tick() -> void:
	demo_tick += 1
	if autoplay:
		var t := demo_tick % AUTOPLAY_LOOP
		if t == 0:
			build_level()
		for a in AUTOPLAY:
			if int(a[0]) == t:
				charge(Vector2((int(a[1]) + 0.5) * CELL, (int(a[2]) + 0.5) * CELL), int(a[3]))
	world.tick()
	debris.step()
	if manual:
		feel.advance(1000.0 / 60.0)
	_step_fx()
	if _callout_cd > 0:
		_callout_cd -= 1
	callouts.step()
	_update_hud()


## A player's charge at a world-local position.
func charge(local_pos: Vector2, instigator: int) -> Dictionary:
	var det := world.detonate(local_pos, CHARGE_RADIUS, CHARGE_POWER, &"blast", instigator)
	return det


func set_reduced_motion(on: bool) -> void:
	reduced_motion = on
	feel.set_reduced_motion(on)
	debris.reduced_motion = on


func _on_detonated(det: Dictionary, _rep: DKReport) -> void:
	var id := int(det["instigator_id"])
	var pos: Vector2 = det["pos"]
	var words := ["BOOM!", "KA-BLAM!", "WHAM!", "KRAK!"]
	var col: Color = PLAYER_COLORS.get(id, Color.WHITE)
	callouts.pop(words[DKDebris._hash(int(pos.x), int(pos.y), 3) % words.size()], pos + Vector2(0, -float(det["radius"]) * 0.7),
		2.0, col.lightened(0.45), col, 55)
	_explosions.append({"pos": det["pos"], "t": 0, "color": PLAYER_COLORS.get(id, Color.WHITE), "r": float(det["radius"])})
	if reduced_motion:
		return
	for k in 7:
		var h := DKDebris._hash(int(det["pos"].x), int(det["pos"].y), k)
		var v := Vector2((float(h % 200) / 100.0 - 1.0) * 0.6, -0.3 - float((h >> 8) % 100) / 200.0)
		_smoke.append({"pos": det["pos"] + v * 8.0, "vel": v, "t": 0, "life": 50 + (h >> 4) % 30, "r": 4.0 + float((h >> 12) % 5)})


func _on_landed(piece: Dictionary, crush: DKDamage, impact: int) -> void:
	pieces_landed += 1
	if _callout_cd <= 0 and impact > 3 and float(piece.get("mass", 0)) > 30.0:
		_callout_cd = 30
		var pr := world.pieces.piece_rect_px(piece)
		callouts.pop("CRASH!", pr.get_center() + Vector2(0, -pr.size.y * 0.5 - 10), 2.0, Color("e9e3d2"), Color("a9b5c8"), 50)
	crush_log.append([int(piece["instigator_id"]), crush.instigator_id, crush.power])


func _step_fx() -> void:
	var keep: Array = []
	for e in _explosions:
		e["t"] += 1
		if e["t"] < 22:
			keep.append(e)
	_explosions = keep
	var ks: Array = []
	for s in _smoke:
		s["t"] += 1
		s["pos"] += s["vel"]
		s["vel"] *= 0.97
		if s["t"] < s["life"]:
			ks.append(s)
	_smoke = ks
	fx.queue_redraw()


# — Drawing (procedural FX, pixel-snapped) —

func _draw_fx() -> void:
	for s in _smoke:
		var k := float(s["t"]) / float(s["life"])
		var r := float(s["r"]) * (1.0 + k * 1.6)
		var c := Color(0.32, 0.27, 0.33, 0.55 * (1.0 - k))
		fx.draw_circle((s["pos"] as Vector2).round(), round(r), c)
	for e in _explosions:
		var t := int(e["t"])
		var p: Vector2 = (e["pos"] as Vector2).round()
		var r: float = e["r"]
		if t < 3:
			fx.draw_circle(p, round(r * 0.9), Color("fff4d6"))
		elif t < 12:
			var k := float(t - 3) / 9.0
			fx.draw_circle(p, round(r * (0.8 - 0.5 * k)), Color("ff8a3d"))
			fx.draw_circle(p, round(r * (0.55 - 0.4 * k)), Color("ffd36b"))
		var ring := r * (0.6 + float(t) / 22.0 * 0.9)
		var col: Color = e["color"]
		fx.draw_arc(p, round(ring), 0.0, TAU, 40, Color(col, 1.0 - float(t) / 22.0), 2.0)
	if not manual and _mouse.x > -50:
		var m := (_mouse - fx.position).round()
		var cc := Color("fff1d6")
		for d in [Vector2(1, 0), Vector2(-1, 0), Vector2(0, 1), Vector2(0, -1)]:
			fx.draw_line(m + d * 3.0, m + d * 7.0, Color("1a1423"), 3.0)
			fx.draw_line(m + d * 3.0, m + d * 7.0, cc, 1.0)


# — HUD —

func _build_hud() -> void:
	var layer := CanvasLayer.new()
	layer.layer = 5
	add_child(layer)
	font = DemoPixelFont.new()
	ui_art = DemoUIArt.new()
	hud = DemoHud.new()
	hud.setup(font, ui_art, &"lite")
	hud.title = "COLLAPSE"
	hud.subtitle = "GODOT DESTRUCTION CORE"
	hud.badge = "LITE"
	hud.title_icon = &"wreck"
	hud.stats = [{"icon": &"hero", "value": "0", "label": "P1 CELLS", "tint": PLAYER_COLORS[1]},
		{"icon": &"hero", "value": "0", "label": "P2 CELLS", "tint": PLAYER_COLORS[2]},
		{"icon": &"falling", "value": "0", "label": "FALLING"}, {"icon": &"landed", "value": "0", "label": "LANDED"},
		{"icon": &"debris", "value": "0", "label": "DEBRIS"}]
	layer.add_child(hud)
	_hud["layer"] = layer


func _update_hud() -> void:
	if hud == null or demo_tick % 6 != 0:
		return
	var s := world.instigator_stats
	hud.set_stat(0, str(int((s.get(1, {}) as Dictionary).get("destroyed", 0))))
	hud.set_stat(1, str(int((s.get(2, {}) as Dictionary).get("destroyed", 0))))
	hud.set_stat(2, str(world.pieces.pieces.size()))
	hud.set_stat(3, str(pieces_landed))
	hud.set_stat(4, str(debris.alive))
	hud.keys = [["LMB", "P1 CHARGE"], ["RMB", "P2 CHARGE"], ["M", "MOTION " + ("ON" if reduced_motion else "OFF")],
		["R", "REBUILD"], ["SPACE", "AUTOPLAY " + ("ON" if autoplay else "OFF")]]
	hud.queue_redraw()


# — Input —

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseMotion:
		_mouse = get_global_mouse_position()
	elif event is InputEventMouseButton and event.pressed:
		var id := 1 if event.button_index == MOUSE_BUTTON_LEFT else (2 if event.button_index == MOUSE_BUTTON_RIGHT else 0)
		if id > 0:
			autoplay = false
			charge(world.to_local(get_global_mouse_position()), id)
	elif event is InputEventKey and event.pressed and not event.echo:
		match event.keycode:
			KEY_M:
				set_reduced_motion(not reduced_motion)
			KEY_R:
				build_level()
			KEY_SPACE:
				autoplay = not autoplay
				if autoplay:
					build_level()
